# Chỉ cần khi dùng Netlify Functions (chế độ SERVER). Đặt trong Netlify: Site settings → Environment variables.
ACCESS_TOKEN=doi-thanh-mot-chuoi-ngau-nhien-dai
AI_PROVIDER=anthropic          # hoặc openai
AI_API_KEY=
AI_MODEL=                      # để trống = mặc định (anthropic: claude-sonnet-5-5)
AI_BASE_URL=                   # chỉ cho nhà cung cấp tương thích OpenAI (vd https://openrouter.ai/api/v1)
ALLOWED_ORIGINS=               # tuỳ chọn, phân tách bằng dấu phẩy
AI_PRICE_IN=                   # USD / 1 triệu token vào (tuỳ chọn, để tính chi phí)
AI_PRICE_OUT=
